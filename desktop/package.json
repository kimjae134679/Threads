{
  "name": "threads-cut-editor",
  "version": "0.3.24",
  "private": true,
  "description": "Source screenshot and cut editor",
  "author": "Threads project",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win zip --x64 --publish never",
    "smoke": "electron smoke.cjs",
    "smoke:curation": "electron curation-smoke.cjs",
    "smoke:auto": "electron auto-batch-smoke.cjs",
    "smoke:review": "electron post-review-smoke.cjs",
    "smoke:workflow": "electron review-workflow-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.threads.sourcecut",
    "productName": "Threads Cut Editor",
    "artifactName": "Threads-Cut-Editor-${version}-Windows-x64.zip",
    "files": [
      "main.cjs",
      "preload.cjs",
      "capture.cjs",
      "network.cjs",
      "package.json",
      "reference-store.cjs",
      "saved-materials.cjs",
      "folder-batch.cjs",
      "source-access.cjs",
      "source-import.cjs",
      "public-source.cjs",
      "batch-input.cjs",
      "batch-service.cjs",
      "batch-catalog.cjs",
      "atomic-file.cjs",
      "cover-asset.cjs",
      "post-review-store.cjs",
      "post-review-service.cjs",
      "post-review-preload.cjs",
      "material-paths.cjs",
      "production-triage.cjs",
      "feedback-migration.cjs",
      "review-release.cjs",
      "activate-review-round-fresh.cjs",
      "review-workflow-model.cjs",
      "review-installed-audit.cjs",
      "batch-render.cjs",
      "universal-reproduction.cjs",
      "universal-cover.cjs",
      "universal-cover-canvas.cjs",
      "square-cover.cjs",
      "square-cover-canvas.cjs",
      "title-layout.cjs",
      "intake-policy.cjs",
      "intake-pipeline.cjs",
      "intake-pipeline-cli.cjs",
      "intake-pipeline-run.cjs",
      "reflow-review-covers-run.cjs",
      "review-canonical-writer.cjs",
      "pc-review-entry.cjs"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "editor",
        "filter": [
          "source-cut-*.html",
          "source-cut-*.css",
          "source-cut-*.js",
          "fonts/**",
          "source-community-*.js",
          "source-batch*.html",
          "source-batch*.css",
          "source-batch*.js",
          "source-curation.js",
          "source-page-plan.js",
          "source-bundle-zip.js",
          "source-workflow.js",
          "viral-model.js",
          "universal-production-model.js"
        ]
      },
      {
        "from": "..",
        "to": "pc-review",
        "filter": [
          "package.json",
          "desktop/post-review-store.cjs",
          "desktop/review-workflow-model.cjs",
          "desktop/atomic-file.cjs",
          "desktop/feedback-migration.cjs",
          "desktop/review-canonical-writer.cjs",
          "desktop/review-release.cjs",
          "mobile/android-review/pc/exchange.mjs",
          "mobile/android-review/pc/feedback-transaction.mjs",
          "mobile/android-review/pc/github-transport.mjs",
          "mobile/android-review/pc/pc-binding.mjs",
          "mobile/android-review/pc/publish-release.mjs",
          "mobile/android-review/pc/release-feed.mjs",
          "mobile/android-review/pc/review-pipeline.mjs",
          "mobile/android-review/app/core.js",
          "mobile/android-review/PC_0318_BINDING.md",
          "mobile/android-review/PC_FEEDBACK_TRANSACTION.md",
          "mobile/android-review/PC_RELEASE_FEED.md",
          "mobile/android-review/app/review-limits.js",
          "mobile/android-review/pc/pc-review-runner.mjs",
          "mobile/android-review/pc/pc-review-config.example.json"
        ]
      }
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    }
  }
}

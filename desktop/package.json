{
  "name": "threads-cut-editor",
  "version": "0.3.39-unified.20261014.1",
  "private": true,
  "description": "Source screenshot and cut editor",
  "author": "Threads project",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win zip --x64 --publish never",
    "smoke": "electron smoke.cjs",
    "smoke:curation": "electron curation-smoke.cjs",
    "smoke:auto": "electron auto-batch-smoke.cjs",
    "smoke:review": "electron post-review-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.threads.sourcecut",
    "productName": "Threads Cut Editor",
    "artifactName": "Threads-Cut-Editor-${version}-Windows-x64.zip",
    "files": [
      "*.cjs",
      "!after-pack.cjs",
      "image-requirements-schema.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "editor",
        "filter": [
          "source-*.html",
          "source-*.css",
          "source-*.js",
          "universal-production-model.js",
          "unified-material-txt.js",
          "viral-model.js",
          "fonts/**"
        ]
      },
      {
        "from": "../mobile/android-review",
        "to": "pc-review/mobile/android-review",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../repo-candidates.mjs",
        "to": "unified-runtime/repo-candidates.mjs"
      },
      {
        "from": "../app",
        "to": "unified-runtime/app",
        "filter": [
          "unified-material-txt.js",
          "source-page-plan.js",
          "source-cover-typography.js",
          "source-cut-zip.js",
          "source-bundle-zip.js"
        ]
      },
      {
        "from": "../upload-studio",
        "to": "unified-runtime/upload-studio",
        "filter": [
          "*.mjs",
          "public/**",
          "vendor/*.mjs",
          "vendor/provenance.json",
          "vendor/production-contract-provenance.json"
        ]
      },
      {
        "from": "../node_modules/linkedom/worker.js",
        "to": "unified-runtime/vendor/linkedom-worker.mjs"
      },
      {
        "from": "../node_modules/linkedom/LICENSE",
        "to": "unified-runtime/vendor/linkedom-LICENSE"
      }
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    },
    "afterPack": "after-pack.cjs"
  }
}

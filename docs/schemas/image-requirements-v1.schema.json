            "right": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "bottom": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "left": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            }

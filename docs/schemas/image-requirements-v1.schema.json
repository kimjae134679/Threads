            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "locator",
        "text"
      ]
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rightsStatus": {
          "type": "string",
          "enum": [
            "unknown",
            "reference_only",
            "user_owned",
            "licensed_commercial"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",

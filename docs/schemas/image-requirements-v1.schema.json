      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "promptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "promptVersion": {
          "const": "threads-image-prompt-v1"
        },
        "postId": {
          "type": "string",
          "minLength": 1
        },
        "productionVersion": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {

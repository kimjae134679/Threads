          "minLength": 1
        },
        "peopleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1

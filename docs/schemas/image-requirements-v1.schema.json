                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "region": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "originalSourceId",
                "mediaName",
                "sha256",
                "region"

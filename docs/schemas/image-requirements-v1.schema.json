              "enum": [
                "user_owned",
                "licensed_commercial"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "sha256",
        "promptSha256",
        "promptVersion",
        "postId",
        "productionVersion",
        "generatedAt",
        "tool",
        "rights",
        "reviewedBy"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {

  "observations": {
    "humor_ssul": {
      "format": "민트색 제목 표지",
      "evidence": "첫 장은 큰 검정 제목, 이후 장은 방송 캡처나 원문 자료로 전환한다."
    },
    "ikpann.co.kr": {
      "format": "사진 표지와 원문 캡처",
      "evidence": "사진 표지와 하단 검정 제목 띠 뒤에 커뮤니티 원문 캡처를 이어 붙인다. 확인한 사례에는 마지막 광고 장과 원문 겹침이 있어 제작 대상에서 구분한다."
    },
    "humor_saul": {
      "format": "AAA 보관 이미지",
      "evidence": "현재 프로필에는 페이지를 사용할 수 없다는 화면이 보인다. AAA의 20~22번 이미지로 민트색 표지와 본문 방식만 분석한다."
    },
    "ddoz_ddoz": {
      "format": "사진 표지와 원문 캡처",
      "evidence": "라면 게시물은 사진 아래쪽에 어두운 그라데이션을 겹쳐 흰 제목을 읽게 한다. 스터디카페 사례는 대화 캡처를 이어 붙인다."
    },
    "baeggopbox": {
      "format": "흰 바탕 외곽선 제목",
      "evidence": "월급 사례의 첫 장은 사진 없이 큰 제목으로 상황을 제시한다. 흰 글자에 굵은 검정 외곽선을 쓴다."
    },
    "humor_yonggari": {
      "format": "사진과 강조 제목",
      "evidence": "내부고발 사례는 흐린 사진 배경과 노랑 및 흰 제목을 함께 쓴다. 제목 외곽선이 강하다."
    },
    "history.me_me": {
      "format": "원문과 설명 이미지",
      "evidence": "조선 항의 사례는 커뮤니티 문단과 삽화를 이어 보여준다. 바둑 이야기와 도쿄대 의혹 사례도 원문 설명의 순서를 유지해 여러 장으로 전개한다. 의혹이나 원작성자의 주장을 확정된 역사 사실로 바꾸지 않는다."
    },
    "choi_20223": {
      "format": "사진과 방송 대화",
      "evidence": "새 수집은 사진 위 하단 검정 그라데이션과 왼쪽 흰 제목, 방송 프레임을 세로로 쌓은 본문, 긴 캡션을 사용한다. 기존 AAA에는 인물 사진 비교와 기사 문단도 있어 자료 종류에 맞춰 구성을 바꾼다."
    }
  },
